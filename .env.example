# Copy to .env and adjust as needed. Values below match the defaults used
# in application.properties and docker-compose.yml.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=supportiq
DB_USER=supportiq
DB_PASSWORD=supportiq

OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

CHAT_MAX_RESULTS=5
CHAT_MEMORY_MAX_MESSAGES=20
